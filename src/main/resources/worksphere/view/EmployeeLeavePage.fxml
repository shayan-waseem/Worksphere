<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="worksphere.controller.EmployeeLeaveController"
      spacing="25"
      style="-fx-background-color: transparent;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="My Leave Applications"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <VBox spacing="12"
          style="-fx-background-color: rgba(30,58,138,0.15); -fx-background-radius: 18; -fx-padding: 20;">

        <ScrollPane fitToWidth="true"
                    prefHeight="300"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="leaveRowsContainer" spacing="10"/>
        </ScrollPane>
    </VBox>

    <VBox spacing="15"
          style="-fx-background-color: rgba(30,58,138,0.15); -fx-background-radius: 18; -fx-padding: 20;">

        <Label text="Send New Leave"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <HBox spacing="15">
            <ComboBox fx:id="leaveTypeCombo"
                      promptText="Select Type"
                      prefWidth="160"/>
            <DatePicker fx:id="leaveDatePicker"/>
        </HBox>

        <TextArea fx:id="reasonArea"
                  promptText="Write reason..."
                  prefRowCount="3"
                  style="-fx-background-radius: 10;"/>

        <Button text="Send Application"
                onAction="#handleSendLeave"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 10;"/>
    </VBox>

</VBox>