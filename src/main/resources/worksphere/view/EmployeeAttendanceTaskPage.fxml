<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="worksphere.controller.EmployeeAttendanceController"
      spacing="25"
      style="-fx-background-color: transparent;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Attendance &amp; Tasks"
           style="-fx-font-size: 28px;
                  -fx-font-weight: bold;
                  -fx-text-fill: white;"/>

    <VBox spacing="12"
          maxWidth="900"
          style="-fx-background-color: rgba(255,255,255,0.15);
                 -fx-background-radius: 20;
                 -fx-padding: 20;">

        <Label text="View Attendance"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1e3a8a;"/>

        <ScrollPane prefHeight="220"
                    fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">
            <VBox fx:id="attendanceContainer" spacing="8"/>
        </ScrollPane>
    </VBox>

    <VBox spacing="12"
          maxWidth="900"
          style="-fx-background-color: rgba(255,255,255,0.15);
                 -fx-background-radius: 20;
                 -fx-padding: 20;">

        <Label text="View Tasks"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1e3a8a;"/>

        <ScrollPane prefHeight="220"
                    fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">
            <VBox fx:id="taskContainer" spacing="8"/>
        </ScrollPane>
    </VBox>

</VBox>