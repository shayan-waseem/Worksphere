<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      spacing="35" style="-fx-background-color: transparent;">
    
    <VBox spacing="5">
        <Label text="System Overview" style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>
        <Label text="Real-time operational status" style="-fx-text-fill: #94a3b8; -fx-font-size: 14;"/>
    </VBox>

    <HBox spacing="25">
        <VBox prefWidth="280" spacing="12" style="-fx-background-color: rgba(30, 41, 59, 0.7); -fx-padding: 25; -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.05);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Circle radius="5" fill="#10b981"/>
                <Label text="Attendance Rate" style="-fx-text-fill: #94a3b8; -fx-font-size: 14;"/>
            </HBox>
            <Label text="98.2%" style="-fx-text-fill: white; -fx-font-size: 36; -fx-font-weight: bold;"/>
        </VBox>

        <VBox prefWidth="280" spacing="12" style="-fx-background-color: rgba(30, 41, 59, 0.7); -fx-padding: 25; -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.05);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Circle radius="5" fill="#38bdf8"/>
                <Label text="Leave Balance" style="-fx-text-fill: #94a3b8; -fx-font-size: 14;"/>
            </HBox>
            <Label text="14 Days" style="-fx-text-fill: white; -fx-font-size: 36; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <HBox spacing="25" VBox.vgrow="ALWAYS">
        <VBox prefWidth="400" spacing="20" style="-fx-background-color: rgba(30, 41, 59, 0.5); -fx-padding: 30; -fx-background-radius: 25;">
            <Label text="Attendance Status" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <Separator opacity="0.1"/>
            
            <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: rgba(16, 185, 129, 0.2);">
                <Circle radius="30" fill="rgba(16, 185, 129, 0.2)"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Successfully Clocked In" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 16;"/>
                    <Label fx:id="clockInTimeLabel" text="Logged at: 09:02 AM" style="-fx-text-fill: white; -fx-font-size: 14;"/>
                </VBox>
                <Label text="Verified via Biometric Scan" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
            </VBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="20" style="-fx-background-color: rgba(30, 41, 59, 0.5); -fx-padding: 30; -fx-background-radius: 25;">
            <HBox alignment="CENTER_LEFT">
                <Label text="Priority Task Queue" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="3 Active" style="-fx-text-fill: #38bdf8; -fx-font-size: 12;"/>
            </HBox>
            <Separator opacity="0.1"/>
            <VBox spacing="15">
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 15; -fx-background-radius: 12;">
                    <CheckBox selected="true" disable="true"/>
                    <VBox>
                        <Label text="Complete System Migration" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label text="Project: WorkSphere v2.0" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="High" style="-fx-text-fill: #f87171; -fx-font-size: 12; -fx-padding: 4 8; -fx-background-color: rgba(248,113,113,0.1); -fx-background-radius: 5;"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 15; -fx-background-radius: 12;">
                    <CheckBox selected="false"/>
                    <VBox>
                        <Label text="UI Refinement" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label text="Dashboard Styling" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Med" style="-fx-text-fill: #fbbf24; -fx-font-size: 12; -fx-padding: 4 8; -fx-background-color: rgba(251,191,36,0.1); -fx-background-radius: 5;"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>